{
  "experiment_id": "control_full_spectrum_v3",
  "arm": "main",
  "trainer": "scripts/train_materialized_streaming.py",
  "data": {"input": "data/materialized_training_v1_1m", "max_train_spectra_per_epoch": 200000, "max_val_spectra": 20000},
  "model": {"architecture": "DynamicSpectraTransformerWithRedshiftToken", "d_model": 128, "num_layers": 3, "nhead": 4, "patch_size": 61},
  "optimization": {"epochs": 500, "batch_size": 3072, "lr": 0.0003, "alpha": 1.25, "reconstruction_weight": 1.0, "seed": 42},
  "reconstruction": {"mask_prob": 0.15, "mask_mode": "contiguous"},
  "classification": {"classes": ["GALAXY", "QSO"], "weight": 0.25},
  "target_selection": {"classes": ["BGS", "LRG", "ELG", "QSO"], "weight": 0.25, "semantics": "multi-label DESI targeting bits; not mutually exclusive spectral truth"},
  "runtime": {"prefetch_batches": 4},
  "augmentation": {"variable_min_fraction": 1.0, "random_transforms": false, "transform_gain": 0.1, "transform_tilt": 0.1, "transform_offset": 0.05, "transform_noise": 0.02},
  "early_stopping": {"patience": 500, "min_delta": 0.0001, "selection_metric": "z_sigma_nmad"}
}
